openapi: 3.0.3
info:
  title: Organization Audit Logs API
  version: 1.0.0
  description: |
    API for retrieving organization-level audit log events, such as
    user management and team membership changes.

    This spec is designed for read-only access to audit events, with
    support for filtering, sorting, and pagination.

servers:
  - url: https://api.example.com
    description: Production API server
  - url: https://staging-api.example.com
    description: Staging API server

tags:
  - name: Audit Logs
    description: Retrieve organization audit log events.

paths:
  /api/v1/organization/audit-logs:
    get:
      tags:
        - Audit Logs
      summary: List audit log events
      description: |
        Returns a paginated list of audit log events for the organization.

        Supports filtering by time range, event type, actor, and resource,
        as well as sorting by timestamp.
      operationId: listAuditLogs
      security:
        - ApiKeyAuth: []
      parameters:
        - name: from
          in: query
          description: |
            Start of time range to filter events (inclusive), in ISO 8601 format.
            Example: `2025-01-01T00:00:00Z`
          required: false
          schema:
            type: string
            format: date-time
        - name: to
          in: query
          description: |
            End of time range to filter events (exclusive), in ISO 8601 format.
            Example: `2025-01-31T23:59:59Z`
          required: false
          schema:
            type: string
            format: date-time
        - name: eventType
          in: query
          description: |
            Filter by a specific event type.

            Common values might include:
            - `team_member.added`
            - `team_member.removed`
            - `team_member.updated`
            - `role.assigned`
            - `role.revoked`
          required: false
          schema:
            type: string
        - name: actorId
          in: query
          description: Filter by the unique ID of the actor who triggered the event.
          required: false
          schema:
            type: string
        - name: actorEmail
          in: query
          description: Filter by the email address of the actor who triggered the event.
          required: false
          schema:
            type: string
            format: email
        - name: resourceType
          in: query
          description: |
            Filter by the type of resource affected by the event.
            For example: `team`, `user`, `role`, `organization`.
          required: false
          schema:
            type: string
        - name: resourceId
          in: query
          description: Filter by the unique ID of the resource affected by the event.
          required: false
          schema:
            type: string
        - name: sort
          in: query
          description: |
            Sort order for results by timestamp.

            - `asc`  - ascending (oldest first)
            - `desc` - descending (newest first, default)
          required: false
          schema:
            type: string
            enum: [asc, desc]
            default: desc
        - name: limit
          in: query
          description: |
            Maximum number of events to return in a single page.
            Defaults to 50. Maximum is 1000.
          required: false
          schema:
            type: integer
            minimum: 1
            maximum: 1000
            default: 50
        - name: cursor
          in: query
          description: |
            Cursor for pagination. Use the `nextCursor` value from a previous
            response to fetch the next page of results.
          required: false
          schema:
            type: string
      responses:
        '200':
          description: A paginated list of audit log events.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AuditLogPage'
        '400':
          description: Invalid request parameters.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorResponse'
        '401':
          description: Authentication failed or missing credentials.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorResponse'
        '403':
          description: The client is authenticated but not authorized to view audit logs.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorResponse'
        '429':
          description: Too many requests (rate limit exceeded).
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorResponse'
        '500':
          description: Internal server error.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorResponse'

components:
  securitySchemes:
    ApiKeyAuth:
      type: apiKey
      in: header
      name: X-API-Key

  schemas:
    AuditLogPage:
      type: object
      description: Paginated audit log results.
      properties:
        items:
          type: array
          description: List of audit log events.
          items:
            $ref: '#/components/schemas/AuditLogEvent'
        nextCursor:
          type: string
          nullable: true
          description: |
            Cursor to fetch the next page of results.
            `null` if there are no more results.
        previousCursor:
          type: string
          nullable: true
          description: |
            Cursor to fetch the previous page of results.
            `null` if this is the first page.
      required:
        - items

    AuditLogEvent:
      type: object
      description: A single audit log event.
      properties:
        id:
          type: string
          description: Unique identifier for the audit log event.
          example: "evt_01H8YJ2B0FNYG123456789ABCD"
        timestamp:
          type: string
          format: date-time
          description: Time when the event occurred (in UTC).
          example: "2025-02-24T10:15:30Z"
        eventType:
          type: string
          description: |
            Machine-readable type of the event.

            Examples:
            - `team_member.added`
            - `team_member.removed`
            - `team_member.updated`
            - `role.assigned`
            - `role.revoked`
          example: "team_member.added"
        actor:
          $ref: '#/components/schemas/AuditLogActor'
        resource:
          $ref: '#/components/schemas/AuditLogResource'
        metadata:
          type: object
          description: |
            Additional structured data about the event.
            Keys and values may vary depending on event type.
          additionalProperties:
            oneOf:
              - type: string
              - type: number
              - type: boolean
              - type: array
                items:
                  type: string
        request:
          $ref: '#/components/schemas/AuditLogRequestContext'
      required:
        - id
        - timestamp
        - eventType

    AuditLogActor:
      type: object
      description: The actor who initiated the event.
      properties:
        id:
          type: string
          description: Unique identifier of the actor (user, system, or API key).
          example: "user_123456"
        type:
          type: string
          description: Type of actor.
          enum:
            - user
            - system
            - api_key
          example: "user"
        email:
          type: string
          format: email
          nullable: true
          description: Email address of the actor, if applicable.
          example: "admin@example.com"
        displayName:
          type: string
          nullable: true
          description: Human-readable name of the actor, if available.
          example: "Jane Admin"
      required:
        - id
        - type

    AuditLogResource:
      type: object
      description: The resource affected by the event.
      properties:
        id:
          type: string
          description: Unique identifier of the resource.
          example: "team_987654"
        type:
          type: string
          description: Type of resource.
          example: "team"
        name:
          type: string
          nullable: true
          description: Human-readable name of the resource, if applicable.
          example: "Engineering"
      required:
        - id
        - type

    AuditLogRequestContext:
      type: object
      description: Request-level context for the audit event.
      properties:
        ipAddress:
          type: string
          description: IP address from which the request originated.
          example: "203.0.113.42"
        userAgent:
          type: string
          description: User agent string of the client.
          example: "Mozilla/5.0 (Macintosh; Intel Mac OS X 10_15_7)"
        clientId:
          type: string
          nullable: true
          description: |
            Identifier of the client application (if applicable),
            for example an OAuth client ID or integration ID.
          example: "cli_abc123"
        requestId:
          type: string
          nullable: true
          description: |
            Internal request identifier for traceability.
          example: "req_01H8YJ2B0FNYG123456789ABCD"

    ErrorResponse:
      type: object
      description: Error response payload.
      properties:
        error:
          type: string
          description: Short, machine-readable error code.
          example: "invalid_request"
        message:
          type: string
          description: Human-readable description of the error.
          example: "The 'from' parameter must be earlier than 'to'."
        requestId:
          type: string
          nullable: true
          description: Internal request identifier for troubleshooting.
          example: "req_01H8YJ2B0FNYG123456789ABCD"
      required:
        - error
        - message
